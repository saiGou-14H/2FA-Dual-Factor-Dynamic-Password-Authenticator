/* ============================================================
   通用按钮
   ============================================================ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: transform 0.14s ease, opacity 0.14s ease, background 0.14s ease;
}
.btn:active { transform: scale(0.985); opacity: 0.9; }
.btn-solid { background: var(--brand); color: #fff; box-shadow: 0 8rpx 20rpx -8rpx rgba(37, 99, 235, 0.5); }
.btn-line { background: var(--card); border: 1rpx solid var(--line-strong); color: var(--sub); }

/* ============================================================
   表单
   ============================================================ */
.group {
  background: var(--card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 8rpx 24rpx -16rpx rgba(17, 24, 39, 0.16);
}
.group-title { padding: 26rpx 30rpx 6rpx; font-size: 22rpx; color: var(--faint); letter-spacing: 1rpx; }
.field {
  display: flex; align-items: center; min-height: 106rpx; padding: 12rpx 30rpx;
  border-top: 1rpx solid var(--line); transition: background 0.14s ease;
}
.group-title + .field { border-top: none; }
.field:active { background: var(--bg-soft); }
.field-label { width: 156rpx; flex-shrink: 0; font-size: 27rpx; color: var(--sub); }
.field-input { flex: 1; font-size: 30rpx; color: var(--ink); }
.field-placeholder { color: var(--faint); }
.hint { padding: 4rpx 30rpx 26rpx; font-size: 22rpx; line-height: 1.7; color: var(--faint); }

.num { font-family: var(--font-num); font-variant-numeric: tabular-nums; }

/* ============================================================
   动效
   ============================================================ */
/* 列表入场（stagger） */
@keyframes rise {
  from { opacity: 0; transform: translateY(18rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 轻微上浮（空态、片段） */
@keyframes float-in {
  from { opacity: 0; transform: translateY(10rpx) scale(0.99); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 换码翻转：绕顶边落下 */
@keyframes flip {
  0%   { opacity: 0; transform: perspective(600rpx) rotateX(-64deg); transform-origin: 50% 0; }
  60%  { opacity: 1; }
  100% { opacity: 1; transform: perspective(600rpx) rotateX(0); transform-origin: 50% 0; }
}

/* 元素淡入缩放（复制反馈等） */
@keyframes pop {
  0%   { opacity: 0; transform: scale(0.6); }
  100% { opacity: 1; transform: scale(1); }
}

/* 遮罩淡入 */
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }

/* 底部抽屉上滑 */
@keyframes sheet-up {
  from { opacity: 0.4; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 弹窗居中放大 */
@keyframes dialog-in {
  from { opacity: 0; transform: scale(0.94); }
  to   { opacity: 1; transform: scale(1); }
}

/* 下拉刷新箭头旋转 */
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 页面入场：只用透明度
   ⚠️ 不能给页面根节点加 transform —— transform 会让 position: fixed 的子孙
   改为相对该节点定位（而非视口），导致浮层/遮罩/FAB 全部错位。 */
@keyframes page-fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 导航栏入场：从上方轻落 */
@keyframes nav-in {
  from { opacity: 0; transform: translateY(-8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 悬浮菜单卡片从右下角展开 */
@keyframes fab-card-in {
  from { opacity: 0; transform: translateY(12rpx) scale(0.94); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 页面内容分层入场 */
.page-enter {
  animation: page-fade var(--dur-3) var(--ease-out) both;
}
.nav-enter {
  animation: nav-in var(--dur-2) var(--ease-out) both;
}
.enter-1 {
  animation: page-in var(--dur-3) var(--ease-out) both;
  animation-delay: 0.05s;
}
.enter-2 {
  animation: page-in var(--dur-3) var(--ease-out) both;
  animation-delay: 0.1s;
}
.enter-3 {
  animation: page-in var(--dur-3) var(--ease-out) both;
  animation-delay: 0.15s;
}

/* 加载指示：三点呼吸 */
@keyframes breathe {
  0%, 100% { opacity: 0.25; transform: scale(0.82); }
  50%      { opacity: 1; transform: scale(1); }
}

/* 剩余时间不足时的细微提示 */
@keyframes warn-pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.55; }
}

/* ============================================================
   导航标题（自定义导航栏统一居中）
   ============================================================ */
.nav-bar {
  position: relative;
}
.nav-title-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  max-width: 62%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}
.nav-count-abs {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}
