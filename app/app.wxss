/* ============================================================
   验证器 —— 设计系统
   明亮、克制。单一品牌蓝，单一告警红，行式列表（iOS 风格）。
   所有页面只引用这里的 token，禁止硬编码颜色。
   ============================================================ */
page {
  /* 表面 */
  --bg: #ffffff;
  --bg-soft: #f4f5f7;
  --card: #ffffff;

  /* 墨色 */
  --ink: #101418;
  --sub: #6b7280;
  --faint: #9ca3af;
  --line: #eceef1;
  --line-strong: #e2e5ea;

  /* 品牌蓝（唯一） */
  --brand: #2563eb;
  --brand-strong: #1d4ed8;
  --brand-soft: #eef4ff;
  --brand-ink: #2563eb;

  /* 告警红（唯一） */
  --ok: #16a34a;
  --ok-soft: #f0fdf4;
  --brand-light: #3b82f6;
  --brand-line: #cfe0ff;
  --danger: #dc2626;
  --danger-soft: #fef2f2;

  /* 数字字体 */
  --font-num: 'DIN Alternate', 'Bahnschrift', 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace;
  --font-ui: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans SC', 'Helvetica Neue', sans-serif;

  /* 动效令牌：统一曲线与时长 */
  --ease: cubic-bezier(0.22, 0.8, 0.2, 1);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --spring: cubic-bezier(0.34, 1.32, 0.64, 1);
  --dur-1: 0.16s;
  --dur-2: 0.26s;
  --dur-3: 0.4s;

  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-ui);
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 100%;
  -webkit-font-smoothing: antialiased;
}

.safe-bottom { height: calc(28rpx + env(safe-area-inset-bottom)); }

/* ============================================================
   图标系统 —— 统一矢量（SVG mask + currentColor）
   所有图标共用一套几何规范：viewBox 24 / 描边 2 / 圆头圆角。
   颜色跟随父级 color，无需为每种颜色单独定义。
   ============================================================ */
.ico {
  display: block;
  flex-shrink: 0;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: 100% 100%;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: 100% 100%;
}

