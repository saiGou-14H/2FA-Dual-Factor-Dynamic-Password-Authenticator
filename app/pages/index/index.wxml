<view class="page page-enter">
  <!-- 自定义导航栏：让开胶囊按钮 -->
  <view class="nav nav-enter">
    <view class="nav-status" style="height:{{statusBarHeight}}px"></view>
    <view class="nav-bar" style="height:{{navBarHeight}}px; padding-right:{{menuRightSpace}}px">
      <view class="nav-title nav-title-center">双因子密码验证器</view>
    </view>
  </view>

  <!-- 身份行：微信头像 + 昵称 -->
  <view class="identity enter-1" bindtap="openAuthIfNeeded">
    <image class="identity-avatar" wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" />
    <view class="identity-avatar is-empty" wx:else>
      <view class="ico ico-plus"></view>
    </view>
    <view class="identity-body">
      <view class="identity-name">{{authorized ? nickname : '点击授权微信头像与昵称'}}</view>
      <view class="identity-sub">{{authorized ? syncText : '授权后身份与密钥一起加密同步，换机不丢'}}</view>
    </view>
  </view>

  <view class="search enter-2">
    <view class="ico ico-search"></view>
    <input class="search-input" value="{{query}}" placeholder="搜索发行方或账号"
           placeholder-class="search-ph" confirm-type="search" bindinput="onSearch" />
    <view class="search-clear" wx:if="{{query}}" bindtap="clearSearch">
        <view class="ico ico-close"></view>
      </view>
    <view class="search-divider"></view>
    <view class="search-toggle" bindtap="toggleAll" aria-label="显示或隐藏验证码">
      <!-- 图标风格：ico-eye（矢量睁眼/闭眼，默认）/ ico-eye-b（胶囊开关） -->
      <view class="ico ico-eye {{hideAll ? 'off' : ''}}"></view>
    </view>
  </view>

  <view class="group-bar enter-3">
    <scroll-view class="group-scroll" scroll-x="true" show-scrollbar="false" scroll-into-view="{{tabInto}}" scroll-with-animation="true">
      <view class="group-tabs">
        <view class="group-tab {{allActive ? 'is-active' : ''}}" id="tab-all" data-id="all" bindtap="onSelectGroup">
          全部 <text class="tab-count">{{total}}</text>
        </view>
        <view class="group-tab {{selectedGroupId === item.id ? 'is-active' : ''}}" id="tab-{{item.id}}" wx:for="{{groups}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectGroup">
          {{item.name}} <text class="tab-count">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="manage-groups" bindtap="gotoGroups" aria-label="管理分组">
      <view class="ico ico-edit"></view>
    </view>
  </view>

  <!-- 列表区：独立滚动，下拉刷新 + 触底加载 -->
  <scroll-view
    class="list-scroll"
    scroll-y="true"
    enhanced="true"
    show-scrollbar="false"
    refresher-enabled="true"
    refresher-triggered="{{refreshing}}"
    refresher-default-style="none"
    refresher-background="#ffffff"
    lower-threshold="120"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onScrollToLower"
    bindtouchstart="onSwipeStart"
    bindtouchmove="onSwipeMove"
    bindtouchend="onSwipeEnd"
    bindtouchcancel="onSwipeEnd"
  >
    <!-- 自定义下拉指示 -->
    <view class="refresher" style="height:{{refreshing ? 56 : 0}}px">
      <view class="refresher-ring" wx:if="{{refreshing}}"></view>
      <text class="refresher-txt" wx:if="{{refreshing}}">正在刷新</text>
    </view>

    <view class="list {{listAnim}}">
      <otp-card wx:for="{{list}}" wx:key="id" item="{{item}}"
        bind:toggle="onToggle" bind:copy="onCopy" bind:more="onMore" />
    </view>

    <!-- 分页状态 -->
    <view class="loadmore" wx:if="{{visibleTotal > 0}}">
      <view class="loadmore-dots" wx:if="{{loadingMore}}">
        <view class="lm-dot"></view>
        <view class="lm-dot"></view>
        <view class="lm-dot"></view>
      </view>
      <text class="loadmore-txt" wx:if="{{loadingMore}}">正在加载</text>
      <text class="loadmore-txt" wx:elif="{{hasMore}}">上滑加载更多 · 已显示 {{list.length}} / {{visibleTotal}}</text>
      <text class="loadmore-txt" wx:else>共 {{visibleTotal}} 个账号</text>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">
      <view class="empty-title">{{total === 0 ? '还没有账号' : '这个分组里暂无账号'}}</view>
      <view class="empty-sub">{{total === 0 ? '扫描二维码或手动输入密钥' : (query ? '换个关键词试试' : '添加账号或选择其他分组')}}</view>
      <view class="empty-action" wx:if="{{total === 0}}" bindtap="gotoAdd">添加账号</view>
    </view>

    <view class="scroll-bottom-gap"></view>
  </scroll-view>

  <view class="move-overlay" wx:if="{{showMoveSheet}}">
    <view class="move-mask" bindtap="closeMoveSheet"></view>
    <view class="move-sheet">
      <view class="move-head">
        <text>移动到分组</text>
        <text class="move-close" bindtap="closeMoveSheet">取消</text>
      </view>
      <scroll-view class="move-list" scroll-y="true">
        <view class="move-option" wx:for="{{moveGroups}}" wx:key="id" data-id="{{item.id}}" bindtap="confirmMoveGroup">
          <text>{{item.name}}</text>
          <view class="ico ico-chevron move-arrow"></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- FAB 遮罩 -->
  <view class="fab-mask" wx:if="{{showFabMenu}}" bindtap="closeFab"></view>

  <!-- FAB 菜单：一张卡片三个选项 -->
  <view class="fab-card" wx:if="{{showFabMenu}}">
    <view class="fab-row" bindtap="fabScan">
      <view class="ico ico-scan fab-row-ico"></view>
      <text class="fab-row-text">扫描二维码</text>
    </view>
    <view class="fab-row" bindtap="fabInput">
      <view class="ico ico-key fab-row-ico"></view>
      <text class="fab-row-text">输入设置密钥</text>
    </view>
    <view class="fab-row" bindtap="fabSettings">
      <view class="ico ico-gear fab-row-ico"></view>
      <text class="fab-row-text">设置</text>
    </view>
  </view>

  <!-- FAB 按钮 -->
  <view class="fab {{showFabMenu ? 'is-open' : ''}}" bindtap="toggleFab" aria-label="添加账号">
    <view class="ico ico-plus"></view>
  </view>

  <!-- 账号操作菜单 -->
  <action-sheet
    show="{{showTokenSheet}}"
    title="{{tokenSheetTitle}}"
    items="{{tokenSheetItems}}"
    bind:select="onTokenAction"
    bind:close="closeTokenSheet"
  />

  <!-- 首次进入的身份授权引导 -->
  <auth-prompt wx:if="{{showAuth}}" show="{{showAuth}}" bind:done="onAuthDone" bind:skip="onAuthSkip" />
</view>
