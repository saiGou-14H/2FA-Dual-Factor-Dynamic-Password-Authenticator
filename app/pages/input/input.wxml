<view class="page page-enter">
  <view class="nav nav-enter">
    <view class="nav-status" style="height:{{statusBarHeight}}px"></view>
    <view class="nav-bar" style="height:{{navBarHeight}}px; padding-right:{{menuRightSpace}}px">
      <view class="nav-back" bindtap="onCancel"><view class="ico ico-back"></view></view>
      <view class="nav-title nav-title-center">{{id ? '编辑账号' : '添加账号'}}</view>
    </view>
  </view>

  <!-- 所属分组（置顶：扫描进入后第一眼可选分组） -->
  <view class="group">
    <view class="field">
      <text class="field-label">所属分组</text>
      <picker class="field-picker" mode="selector" range="{{groupNames}}" value="{{groupIndex}}" bindchange="onGroupChange">
        <view class="picker-value">{{groupNames[groupIndex]}}<view class="ico ico-chevron picker-caret"></view></view>
      </picker>
    </view>
    <view class="new-group-link" bindtap="onManageGroups">＋ 新建分组</view>
  </view>

  <!-- 基本信息 -->
  <view class="group">
    <view class="field">
      <text class="field-label">服务名称</text>
      <input class="field-input" value="{{issuer}}" placeholder="GitHub（可留空）"
             placeholder-class="field-placeholder" bindinput="onIssuer" />
    </view>
    <view class="field">
      <text class="field-label">账号</text>
      <input class="field-input" value="{{label}}" placeholder="alice@example.com"
             placeholder-class="field-placeholder" bindinput="onLabel" />
    </view>
    <view class="field">
      <text class="field-label">密钥</text>
      <input class="field-input num" value="{{secret}}" password="{{!secretVisible}}"
             placeholder="Base32，如 JBSWY3DPEHPK3PXP"
             placeholder-class="field-placeholder" bindinput="onSecret" />
      <text class="reveal" catchtap="toggleSecret">{{secretVisible ? '隐藏' : '显示'}}</text>
    </view>
  </view>

  <!-- 参数 -->
  <view class="group">
    <view class="field">
      <text class="field-label">类型</text>
      <picker class="field-picker" mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onType">
        <view class="picker-value">{{types[typeIndex]}}<view class="ico ico-chevron picker-caret"></view></view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">算法</text>
      <picker class="field-picker" mode="selector" range="{{algorithms}}" value="{{algorithmIndex}}" bindchange="onAlgorithm">
        <view class="picker-value">{{algorithms[algorithmIndex]}}<view class="ico ico-chevron picker-caret"></view></view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">位数</text>
      <picker class="field-picker" mode="selector" range="{{digitsList}}" value="{{digitsIndex}}" bindchange="onDigits">
        <view class="picker-value">{{digitsList[digitsIndex]}}<view class="ico ico-chevron picker-caret"></view></view>
      </picker>
    </view>
    <view class="field" wx:if="{{type === 'totp'}}">
      <text class="field-label">刷新周期</text>
      <picker class="field-picker" mode="selector" range="{{periods}}" value="{{periodIndex}}" bindchange="onPeriod">
        <view class="picker-value">{{periods[periodIndex]}}<view class="ico ico-chevron picker-caret"></view></view>
      </picker>
    </view>
    <view class="field" wx:if="{{type === 'hotp'}}">
      <text class="field-label">计数器</text>
      <input class="field-input num" type="number" value="{{counter}}" bindinput="onCounter" />
    </view>
  </view>

  <view class="error" wx:if="{{errorMsg}}">{{errorMsg}}</view>

  <view class="actions">
    <view class="btn btn-solid" bindtap="onSave">{{id ? '保存修改' : '添加账号'}}</view>
    <view class="btn btn-line" bindtap="onCancel">取消</view>
  </view>

  <view class="notice">密钥只保存在本机。拿到密钥的人可以生成你的全部验证码，不要截图分享。</view>

  <view class="safe-bottom"></view>
</view>
