.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  padding: 0 30rpx;
  box-sizing: border-box;
}

/* 固定导航下的内容滚动区 */
.scroll-body {
  flex: 1;
  min-height: 0;
}


.nav {
  margin: 0 -30rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

/* 高级设置折叠头 */
.adv-toggle {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0 30rpx;
  transition: background var(--dur-1) var(--ease);
}
.adv-toggle:active {
  background: var(--bg-soft);
}
.adv-label {
  font-size: 27rpx;
  color: var(--sub);
  flex-shrink: 0;
}
.adv-summary {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: 22rpx;
  color: var(--faint);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.adv-caret {
  margin-left: 12rpx;
  color: var(--faint);
  transition: transform var(--dur-2) var(--ease);
}
.adv-caret.is-open {
  transform: rotate(90deg);
}
.adv-body {
  border-top: 1rpx solid var(--line);
  animation: float-in var(--dur-2) var(--ease) both;
}

.new-group-link {
  padding: 4rpx 30rpx 24rpx;
  color: var(--brand);
  font-size: 24rpx;
}

/* ---------------- 表单 ---------------- */
.field-tap-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  transition: opacity var(--dur-1) var(--ease);
}
.field-tap-value:active {
  opacity: 0.6;
}
.field-tap-text {
  font-size: 29rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.field-tap-caret {
  color: var(--faint);
  margin-left: 10rpx;
  flex-shrink: 0;
}

.reveal {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
  padding-left: 18rpx;
}

/* ---------------- 错误 ---------------- */
.error {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  border-left: 4rpx solid var(--danger);
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 23rpx;
  line-height: 1.65;
}

/* ---------------- 动作 ---------------- */
.actions {
  margin-top: 8rpx;
}

.actions .btn + .btn {
  margin-top: 16rpx;
}

.notice {
  margin-top: 26rpx;
  font-size: 21rpx;
  line-height: 1.75;
  color: var(--faint);
}
