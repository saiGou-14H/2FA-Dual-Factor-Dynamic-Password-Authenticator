.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 30rpx 32rpx;
  box-sizing: border-box;
}

.nav {
  margin: 0 -30rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

.field-body {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.field-name {
  font-size: 29rpx;
  color: var(--ink);
}

.field-name.is-danger {
  color: var(--danger);
}

.field-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
  line-height: 1.5;
}

.field-value {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--sub);
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-value.is-empty {
  color: var(--faint);
}

.field-arrow {
  flex-shrink: 0;
  color: var(--faint);
}

.field-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.field-right .field-value {
  margin-right: 10rpx;
}

/* ================= 自定义开关 ================= */
.toggle {
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: var(--line-strong);
  position: relative;
  flex-shrink: 0;
  transition: background var(--dur-2) var(--ease);
}
.toggle.is-on {
  background: var(--brand);
}
.toggle-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(17, 24, 39, 0.24);
  transition: transform var(--dur-2) var(--ease);
}
.toggle.is-on .toggle-knob {
  transform: translateX(36rpx);
}

/* ================= 身份头像 ================= */
.ident-avatar {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-soft);
}
.ident-avatar-img {
  width: 100%;
  height: 100%;
}

/* ================= 迁移二维码浮层 ================= */
/* 居中用 flex，不用 transform：避免与入场动画的 transform 互相覆盖 */
.qr-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qr-mask {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(15, 21, 31, 0.5);
  animation: fade 0.2s ease both;
}
.qr-sheet {
  position: relative;
  z-index: 1;
  width: calc(100% - 96rpx);
  max-width: 640rpx;
  padding: 44rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: var(--bg);
  box-sizing: border-box;
  animation: dialog-in var(--dur-2) var(--ease) both;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qr-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.qr-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: center;
}
.qr-box {
  margin-top: 30rpx;
  width: 420rpx;
  height: 420rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  box-sizing: border-box;
}
.qr-img {
  width: 100%;
  height: 100%;
}
.qr-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}
.qr-btn:active { opacity: 0.86; }
