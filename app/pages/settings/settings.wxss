.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 40rpx 32rpx;
  box-sizing: border-box;
}

.nav {
  margin: 0 -40rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

.field-body {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.field-name {
  font-size: 29rpx;
  color: var(--ink);
}

.field-name.is-danger {
  color: var(--danger);
}

.field-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
  line-height: 1.5;
}

.field-value {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--sub);
}

.field-arrow {
  flex-shrink: 0;
  color: var(--faint);
}

.field-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.field-right .field-value {
  margin-right: 10rpx;
}

/* ================= 迁移二维码浮层 ================= */
.qr-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 200;
}
.qr-mask {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(15, 21, 31, 0.5);
  animation: fade 0.2s ease both;
}
.qr-sheet {
  position: absolute;
  left: 40rpx; right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 44rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: var(--bg);
  animation: dialog-in var(--dur-2) var(--ease) both;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qr-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.qr-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: center;
}
.qr-box {
  margin-top: 30rpx;
  width: 420rpx;
  height: 420rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  box-sizing: border-box;
}
.qr-img {
  width: 100%;
  height: 100%;
}
.qr-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}
.qr-btn:active { opacity: 0.86; }
