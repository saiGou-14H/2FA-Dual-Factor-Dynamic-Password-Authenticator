.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  padding: 0 30rpx;
  box-sizing: border-box;
}

/* 固定导航下的内容滚动区 */
.scroll-body {
  flex: 1;
  min-height: 0;
}


.nav {
  margin: 0 -30rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

.field-body {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.field-name {
  font-size: 29rpx;
  color: var(--ink);
}

.field-name.is-danger {
  color: var(--danger);
}

.field-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
  line-height: 1.5;
}

.field-value {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--sub);
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-value.is-empty {
  color: var(--faint);
}

.field-arrow {
  flex-shrink: 0;
  color: var(--faint);
}

.field-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.field-right .field-value {
  margin-right: 10rpx;
}

/* ================= 自定义开关 ================= */
.toggle {
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: var(--line-strong);
  position: relative;
  flex-shrink: 0;
  transition: background var(--dur-2) var(--ease);
}
.toggle.is-on {
  background: var(--brand);
}
.toggle-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(17, 24, 39, 0.24);
  transition: transform var(--dur-2) var(--ease);
}
.toggle.is-on .toggle-knob {
  transform: translateX(36rpx);
}

/* ================= 身份头像 ================= */
.ident-avatar {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-soft);
}
.ident-avatar-img {
  width: 100%;
  height: 100%;
}

/* ================= 迁移二维码浮层 ================= */
/* 居中用 flex，不用 transform：避免与入场动画的 transform 互相覆盖 */
.qr-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qr-mask {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(15, 21, 31, 0.5);
  animation: fade 0.2s ease both;
}
.qr-sheet {
  position: relative;
  z-index: 1;
  width: calc(100% - 96rpx);
  max-width: 640rpx;
  padding: 44rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: var(--bg);
  box-sizing: border-box;
  animation: dialog-in var(--dur-2) var(--ease) both;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qr-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.qr-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: center;
}
.qr-box {
  margin-top: 30rpx;
  width: 420rpx;
  height: 420rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  box-sizing: border-box;
}
.qr-img {
  width: 100%;
  height: 100%;
}
.qr-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}
.qr-btn:active { opacity: 0.86; }

/* ================= 关于卡片（文字左对齐） ================= */
.about-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 230;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-mask {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(15, 21, 31, 0.46);
  animation: fade 0.18s ease both;
}

.about-card {
  position: relative;
  z-index: 1;
  width: calc(100% - 80rpx);
  max-width: 660rpx;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  border-radius: 28rpx;
  background: var(--bg);
  box-sizing: border-box;
  animation: dialog-in var(--dur-2) var(--ease) both;
  overflow: hidden;
}

.about-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  text-align: left;
}

.about-logo {
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: var(--bg-soft);
}

.about-head-main {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.about-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: left;
}

.about-version {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--faint);
  text-align: left;
}

.about-close {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 6rpx 4rpx;
  font-size: 26rpx;
  color: var(--sub);
}

.about-body {
  max-height: 60vh;
  padding: 8rpx 36rpx 36rpx;
  box-sizing: border-box;
}

.about-section {
  margin-top: 26rpx;
  text-align: left;
}

.about-h {
  margin-bottom: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--faint);
  text-align: left;
}

.about-p {
  font-size: 26rpx;
  line-height: 1.72;
  color: var(--sub);
  text-align: left;
}

.about-item {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
  text-align: left;
}

.about-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 15rpx 14rpx 0 0;
  border-radius: 50%;
  background: var(--brand);
  flex-shrink: 0;
}

.about-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.72;
  color: var(--sub);
  text-align: left;
}

/* ================= 恢复码浮层 ================= */
.rc-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 235;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-mask {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(15, 21, 31, 0.46);
  animation: fade 0.18s ease both;
}
.rc-sheet {
  position: relative;
  z-index: 1;
  width: calc(100% - 80rpx);
  max-width: 660rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: var(--bg);
  box-sizing: border-box;
  animation: dialog-in var(--dur-2) var(--ease) both;
}
.rc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: left;
}
.rc-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: left;
}
.rc-code {
  margin-top: 24rpx;
  padding: 22rpx 20rpx;
  border-radius: 14rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-family: var(--font-num);
  font-size: 24rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
  word-break: break-all;
  text-align: left;
}
.rc-code.is-empty {
  background: var(--bg-soft);
  color: var(--faint);
  font-family: inherit;
  font-size: 23rpx;
}
.rc-tip {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--faint);
  text-align: left;
}
.rc-divider {
  height: 1rpx;
  margin: 28rpx 0 22rpx;
  background: var(--line);
}
.rc-label {
  font-size: 22rpx;
  color: var(--sub);
  text-align: left;
}
.rc-input {
  margin-top: 12rpx;
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: var(--bg-soft);
  box-sizing: border-box;
  font-size: 25rpx;
  font-family: var(--font-num);
  color: var(--ink);
}
.rc-placeholder {
  color: var(--faint);
  font-size: 24rpx;
}
.rc-actions {
  display: flex;
  margin-top: 24rpx;
}
.rc-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
}
.rc-btn:active { opacity: 0.86; transform: scale(0.985); }
.rc-btn-ghost {
  margin-right: 18rpx;
  background: var(--bg-soft);
  color: var(--sub);
}
.rc-btn-solid {
  background: var(--brand);
  color: #fff;
}

/* ================= 云端密钥备份浮层 ================= */
.pw-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 236;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pw-mask {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(15, 21, 31, 0.46);
  animation: fade 0.18s ease both;
}
.pw-sheet {
  position: relative;
  z-index: 1;
  width: calc(100% - 80rpx);
  max-width: 660rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: var(--bg);
  box-sizing: border-box;
  animation: dialog-in var(--dur-2) var(--ease) both;
}
.pw-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: left;
}
.pw-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: left;
}
.pw-input {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: var(--bg-soft);
  box-sizing: border-box;
  font-size: 27rpx;
  color: var(--ink);
}
.pw-placeholder {
  color: var(--faint);
  font-size: 25rpx;
}
.pw-actions {
  display: flex;
  margin-top: 26rpx;
}
.pw-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
}
.pw-btn:active { opacity: 0.86; transform: scale(0.985); }
.pw-btn + .pw-btn { margin-left: 12rpx; }
.pw-btn-ghost {
  background: var(--bg-soft);
  color: var(--sub);
}
.pw-btn-line {
  background: var(--brand-soft);
  color: var(--brand);
}
.pw-btn-solid {
  background: var(--brand);
  color: #fff;
}
.pw-tip {
  margin-top: 18rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: left;
}
