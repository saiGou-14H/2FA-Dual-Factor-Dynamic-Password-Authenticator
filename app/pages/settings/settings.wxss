.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 40rpx 32rpx;
  box-sizing: border-box;
}

.nav {
  margin: 0 -40rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

.field-body {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.field-name {
  font-size: 29rpx;
  color: var(--ink);
}

.field-name.is-danger {
  color: var(--danger);
}

.field-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
  line-height: 1.5;
}

.field-value {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--sub);
}

.field-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1;
  color: var(--faint);
}
