<view class="page page-enter">
  <view class="nav nav-enter">
    <view class="nav-status" style="height:{{statusBarHeight}}px"></view>
    <view class="nav-bar" style="height:{{navBarHeight}}px; padding-right:{{menuRightSpace}}px">
      <view class="nav-back" bindtap="onBack"><view class="ico ico-back"></view></view>
      <view class="nav-title nav-title-center">设置</view>
    </view>
  </view>

  <!-- 内容区：独立滚动，导航固定 -->
  <scroll-view class="scroll-body" scroll-y="true">

  <view class="group enter-3">
    <view class="group-title">显示</view>
    <view class="field">
      <view class="field-body">
        <view class="field-name">默认隐藏验证码</view>
        <view class="field-desc">需要点一下才显示数字</view>
      </view>
      <view class="toggle {{hideCodes ? 'is-on' : ''}}" bindtap="onToggleHide"><view class="toggle-knob"></view></view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">云同步</view>
    <view class="field" bindtap="manualSync">
      <view class="field-body">
        <view class="field-name">立即同步</view>
        <view class="field-desc">{{syncing ? '同步中…' : lastSyncText}}</view>
      </view>
      <view class="ico ico-chevron field-arrow"></view>
    </view>
    <view class="field">
      <view class="field-body">
        <view class="field-name">自动同步</view>
        <view class="field-desc">退出小程序时自动上传</view>
      </view>
      <text class="field-value">已开启</text>
    </view>
    <view class="field" bindtap="openAuthIfNeeded">
      <view class="ident-avatar" wx:if="{{avatar}}">
        <image class="ident-avatar-img" src="{{avatar}}" mode="aspectFill" />
      </view>
      <view class="field-body">
        <view class="field-name">身份</view>
        <view class="field-desc">{{authorized ? '由微信授权提供' : '未授权，点击完善'}}</view>
      </view>
      <view class="field-right">
        <text class="field-value {{authorized ? '' : 'is-empty'}}">{{authorized ? nickname : '未授权'}}</text>
        <view class="ico ico-chevron field-arrow" wx:if="{{!authorized}}"></view>
      </view>
    </view>
    <view class="field">
      <view class="field-body">
        <view class="field-name">已保存账号</view>
      </view>
      <text class="field-value num">{{count}}</text>
    </view>
    <view class="hint">内容在本机加密后才上传，服务端只见密文，无法读取你的验证码。</view>
  </view>

  <view class="group">
    <view class="group-title">换机迁移</view>
    <view class="field" bindtap="openMigrate">
      <view class="field-body">
        <view class="field-name">迁移到其他微信号</view>
        <view class="field-desc">生成二维码，用新微信扫码接收</view>
      </view>
      <view class="ico ico-chevron field-arrow"></view>
    </view>
    <view class="field" bindtap="scanMigrate">
      <view class="field-body">
        <view class="field-name">从二维码迁移</view>
        <view class="field-desc">扫描旧微信生成的迁移码</view>
      </view>
      <view class="ico ico-chevron field-arrow"></view>
    </view>
    <view class="hint">迁移码有效期 5 分钟、仅可使用一次，含解密密钥，请勿泄露。</view>
  </view>

  <view class="group">
    <view class="group-title">数据</view>
    <view class="field" bindtap="gotoRecycle">
      <view class="field-body">
        <view class="field-name">回收站</view>
        <view class="field-desc">按删除时间找回账号</view>
      </view>
      <view class="field-right">
        <text class="field-value num" wx:if="{{deletedCount > 0}}">{{deletedCount}}</text>
        <view class="ico ico-chevron field-arrow"></view>
      </view>
    </view>
    <view class="field" bindtap="gotoExport">
      <view class="field-body">
        <view class="field-name">导出备份</view>
        <view class="field-desc">JSON 与 otpauth 链接</view>
      </view>
      <view class="ico ico-chevron field-arrow"></view>
    </view>
    <view class="field" bindtap="clearAll">
      <view class="field-body">
        <view class="field-name is-danger">清空全部</view>
        <view class="field-desc">移入回收站，可找回</view>
      </view>
      <view class="ico ico-chevron field-arrow"></view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">设备</view>
    <view class="field">
      <view class="field-body"><view class="field-name">本机时间</view></view>
      <text class="field-value num">{{dateText}} {{nowText}}</text>
    </view>
    <view class="hint">验证码依赖设备时钟。时间不准，所有验证码都会错，请开启系统自动对时。</view>
  </view>

  <view class="group">
    <view class="group-title">关于</view>
    <view class="field" bindtap="openAbout">
      <view class="field-body"><view class="field-name">关于这个应用</view></view>
      <view class="ico ico-chevron field-arrow"></view>
    </view>
    <view class="field">
      <view class="field-body"><view class="field-name">版本</view></view>
      <text class="field-value num">{{version}}</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </scroll-view>

  <!-- 迁移二维码浮层 -->
  <view class="qr-overlay" wx:if="{{showMigrate}}">
    <view class="qr-mask" bindtap="closeMigrate"></view>
    <view class="qr-sheet">
      <view class="qr-title">迁移二维码</view>
      <view class="qr-sub">{{migrateTip}}</view>
      <view class="qr-box">
        <image class="qr-img" src="{{qrImage}}" mode="aspectFit" />
      </view>
      <view class="qr-btn" bindtap="closeMigrate">完成</view>
    </view>
  </view>


  <!-- 关于（自定义卡片：文字左对齐） -->
  <view class="about-overlay" wx:if="{{showAbout}}">
    <view class="about-mask" bindtap="closeAbout"></view>

    <view class="about-card">
      <view class="about-head">
        <image class="about-logo" src="/assets/logo.png" mode="aspectFit" />
        <view class="about-head-main">
          <view class="about-title">双因子密码验证器</view>
          <view class="about-version">版本 {{version}}</view>
        </view>
        <view class="about-close" bindtap="closeAbout">关闭</view>
      </view>

      <scroll-view class="about-body" scroll-y="true">
        <view class="about-section">
          <view class="about-p">本地优先的双因子动态密码工具，兼容标准 otpauth 二维码，支持 TOTP 与 HOTP。</view>
        </view>

        <view class="about-section">
          <view class="about-h">数据安全</view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">密钥在本机加密后才上传，服务端只见密文，无法生成你的验证码。</text></view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">身份用你的微信 openid 区分，无需注册登录，也不收集多余信息。</text></view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">头像与昵称只有你主动选择后才会保存，随加密保险库一起同步。</text></view>
        </view>

        <view class="about-section">
          <view class="about-h">同步与换机</view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">退出小程序时自动同步，也可在设置里手动同步。</text></view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">换手机：旧机「迁移到其他微信号」生成二维码，新机扫码即可接收全部账号。</text></view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">迁移码 5 分钟内有效、仅可使用一次，内含解密密钥，请勿外传。</text></view>
        </view>

        <view class="about-section">
          <view class="about-h">使用提示</view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">验证码依赖设备时钟，请开启系统自动对时，否则所有验证码都会错。</text></view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">删除的账号先进入回收站，可按删除日期范围找回或彻底删除。</text></view>
          <view class="about-item"><text class="about-dot"></text><text class="about-text">主码下方的「下一码」在当前码到期后自动生效，可提前准备。</text></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 身份授权引导 -->
  <auth-prompt show="{{showAuth}}" bind:done="onAuthDone" bind:skip="onAuthSkip" />

  <!-- 加载遮罩 -->
  <loading show="{{loadingShow}}" text="{{loadingText}}" />
</view>
