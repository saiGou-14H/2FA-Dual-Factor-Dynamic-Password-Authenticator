.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 30rpx 32rpx;
  box-sizing: border-box;
}

.nav {
  margin: 0 -30rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

/* ---------------- 警告 ---------------- */
.caution {
  display: flex;
  margin-bottom: 26rpx;
}

.caution-bar {
  width: 4rpx;
  flex-shrink: 0;
  background: var(--danger);
  border-radius: 2rpx;
}

.caution-body {
  padding-left: 20rpx;
}

.caution-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--danger);
}

.caution-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--sub);
}

/* ---------------- 分组头 ---------------- */
.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 30rpx 8rpx;
}

.group-act {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
}

.group-act:active {
  opacity: 0.6;
}

/* ---------------- JSON ---------------- */
.json {
  max-height: 300rpx;
  padding: 0 30rpx;
  overflow: hidden;
}

.json-text {
  font-size: 20rpx;
  line-height: 1.8;
  color: var(--sub);
  word-break: break-all;
  white-space: pre-wrap;
}

.json-more {
  padding: 18rpx 30rpx 24rpx;
  font-size: 22rpx;
  color: var(--brand);
}

/* ---------------- URI 行 ---------------- */
.uri {
  padding: 22rpx 30rpx;
  border-top: 1rpx solid var(--line);
  transition: background 0.14s;
}

.uri:active {
  background: var(--bg-soft);
}

.uri-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.uri-text {
  margin-top: 8rpx;
  font-size: 19rpx;
  line-height: 1.7;
  color: var(--faint);
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.uri-act {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--brand);
}

/* ---------------- 尾部说明 ---------------- */
.foot-note {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.75;
  color: var(--faint);
}
