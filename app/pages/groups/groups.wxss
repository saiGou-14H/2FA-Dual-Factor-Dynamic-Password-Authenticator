.page {
  min-height: 100vh;
  background: #fff;
  color: var(--ink);
  display: flex;
  flex-direction: column;
}

.nav {
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.group-list {
  border-bottom: 1rpx solid var(--line);
}

.group-row {
  min-height: 132rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
  gap: 18rpx;
}

.group-row:last-child {
  border-bottom: 0;
}

.drag-mark {
  width: 38rpx;
  color: var(--faint);
}

.group-main,
.rename-field {
  flex: 1;
  min-width: 0;
}

.group-title-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.group-name {
  min-width: 0;
  font-size: 32rpx;
  font-weight: 650;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.group-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border: 1rpx solid #cfe0ff;
  border-radius: 6rpx;
  color: var(--brand);
  background: #eef4ff;
  font-size: 20rpx;
}

.group-count {
  display: block;
  margin-top: 4rpx;
  color: var(--sub);
  font-size: 23rpx;
}

.row-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.arrow-button,
.icon-button {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  background: #eef4ff;
  border-radius: 9rpx;
  font-size: 32rpx;
}

.arrow-button.is-disabled {
  color: #9ca3af;
  background: #f4f5f7;
}

.icon-button {
  color: var(--ink);
  background: transparent;
  font-size: 34rpx;
}

.icon-button.is-danger {
  color: #dc2626;
}

.rename-field input {
  height: 64rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--brand);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.rename-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  padding-top: 8rpx;
  color: var(--sub);
  font-size: 23rpx;
}

.rename-save {
  color: var(--brand);
}

.create-section {
  padding: 54rpx 8rpx 38rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.create-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.create-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e2e5ea;
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 29rpx;
}

.placeholder {
  color: #9ca3af;
}

.create-button {
  width: 128rpx;
  height: 84rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: var(--brand);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}

.notice {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #f4f5f7;
  color: var(--sub);
  font-size: 22rpx;
  line-height: 1.4;
}

.notice-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border: 2rpx solid #6b7280;
  border-radius: 50%;
  text-align: center;
  line-height: 27rpx;
  font-size: 20rpx;
}

.order-hint {
  margin-top: 28rpx;
  text-align: center;
  color: var(--sub);
  font-size: 22rpx;
}

.bottom-space {
  height: 190rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
}

.save-button {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--brand);
  border-radius: 12rpx;
  color: var(--brand);
  background: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.target-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
}

.target-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 21, 31, 0.38);
}

.target-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.target-head {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 650;
}

.target-close {
  color: var(--sub);
  font-size: 24rpx;
  font-weight: 400;
}

.target-list {
  max-height: 58vh;
}

.target-option {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 27rpx;
}

.move-arrow {
  color: var(--faint);
}
