.page {
  min-height: 100vh;
  background: #fff;
  color: var(--ink);
  display: flex;
  flex-direction: column;
}

.nav {
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.group-list {
  border-bottom: 1rpx solid var(--line);
}

.group-row {
  min-height: 132rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
  gap: 18rpx;
}

.group-row:last-child {
  border-bottom: 0;
}

.drag-handle {
  width: 60rpx;
  height: 88rpx;
  margin-left: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--faint);
  flex-shrink: 0;
}
.drag-handle:active {
  color: var(--brand);
}

/* 拖拽中的行 */
.group-row.is-dragging {
  background: var(--bg-soft);
  border-radius: 12rpx;
  transform: scale(1.015);
  box-shadow: 0 10rpx 26rpx -12rpx rgba(17, 24, 39, 0.38);
  transition: transform var(--dur-1) var(--ease);
}

.group-main,
.rename-field {
  flex: 1;
  min-width: 0;
}

.group-title-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.group-name {
  min-width: 0;
  font-size: 32rpx;
  font-weight: 650;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.group-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--brand-line);
  border-radius: 6rpx;
  color: var(--brand);
  background: var(--brand-soft);
  font-size: 20rpx;
}

.group-count {
  display: block;
  margin-top: 4rpx;
  color: var(--sub);
  font-size: 23rpx;
}

.row-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.arrow-button,
.icon-button {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 9rpx;
  font-size: 32rpx;
}

.arrow-button.is-disabled {
  color: var(--faint);
  background: var(--bg-soft);
}

.icon-button {
  color: var(--ink);
  background: transparent;
  font-size: 34rpx;
}

.icon-button.is-danger {
  color: var(--danger);
}

.rename-field input {
  height: 64rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--brand);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.rename-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  padding-top: 8rpx;
  color: var(--sub);
  font-size: 23rpx;
}

.rename-save {
  color: var(--brand);
}

.create-section {
  padding: 54rpx 8rpx 38rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.create-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.create-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 29rpx;
}

.placeholder {
  color: var(--faint);
}

.create-button {
  width: 128rpx;
  height: 84rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: var(--brand);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}

.notice {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: var(--bg-soft);
  color: var(--sub);
  font-size: 22rpx;
  line-height: 1.4;
}

.notice-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--sub);
  border-radius: 50%;
  text-align: center;
  line-height: 27rpx;
  font-size: 20rpx;
}

.order-hint {
  margin-top: 28rpx;
  text-align: center;
  color: var(--sub);
  font-size: 22rpx;
}

.bottom-space {
  height: 190rpx;
}

.target-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
}

.target-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 21, 31, 0.38);
}

.target-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  animation: sheet-up var(--dur-2) var(--ease) both;
  padding: 0 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.target-head {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 650;
}

.target-close {
  color: var(--sub);
  font-size: 24rpx;
  font-weight: 400;
}

.target-list {
  max-height: 58vh;
}

.target-option {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 27rpx;
}
.target-body {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 16rpx;
}
.target-name {
  font-size: 27rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.target-count {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--faint);
}

.move-arrow {
  color: var(--faint);
}
