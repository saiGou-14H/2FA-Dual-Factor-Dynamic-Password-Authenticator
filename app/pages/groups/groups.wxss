.page {
  min-height: 100vh;
  background: #fff;
  color: var(--ink);
  display: flex;
  flex-direction: column;
}

.nav {
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--line);
}
.nav-status { width: 100%; }
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}
.nav-back:active { opacity: 0.5; }
.nav-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* ============ 分组卡片列表 ============ */
.group-list {
  background: var(--card);
  border-radius: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 8rpx 24rpx -16rpx rgba(17, 24, 39, 0.16);
  overflow: hidden;
}

.group-row {
  position: relative;
  min-height: 128rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx 18rpx 2rpx;
  border-bottom: 1rpx solid var(--line);
  box-sizing: border-box;
}
.group-row:last-child {
  border-bottom: 0;
}

/* 被拖起的源行留空，视觉上由悬浮层代替 */
.group-row.is-source {
  opacity: 0;
}

/* 拖拽把手：整行高度都可抓 */
.drag-handle {
  width: 62rpx;
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--faint);
  flex-shrink: 0;
}
.drag-handle:active {
  color: var(--brand);
}

/* 首字头像 */
.group-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 700;
}

.group-main,
.rename-field {
  flex: 1;
  min-width: 0;
}

.group-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 650;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.group-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  color: var(--brand);
  background: var(--brand-soft);
  font-size: 19rpx;
}

.group-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: baseline;
}

.group-count {
  font-family: var(--font-num);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sub);
}

.group-count-unit {
  margin-left: 4rpx;
  font-size: 21rpx;
  color: var(--faint);
}

/* 行内操作 */
.row-actions {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
}

.icon-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: var(--sub);
  transition: background var(--dur-1) var(--ease), opacity var(--dur-1) var(--ease);
}
.icon-button:active {
  background: var(--bg-soft);
}
.icon-button.is-move {
  color: var(--brand);
}
.icon-button.is-disabled {
  color: var(--line-strong);
}
.icon-button.is-danger {
  color: var(--danger);
}

/* ============ 拖拽悬浮层 ============ */
.drag-ghost {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  z-index: 320;
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx 18rpx 2rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: var(--card);
  box-shadow: 0 26rpx 60rpx -18rpx rgba(17, 24, 39, 0.42),
              0 2rpx 8rpx rgba(17, 24, 39, 0.08);
  transform: scale(1.025);
  animation: ghost-lift var(--dur-1) var(--ease) both;
}
.drag-ghost .drag-handle {
  color: var(--brand);
}
.drag-ghost .row-actions {
  display: none;
}

@keyframes ghost-lift {
  from { transform: scale(0.97); opacity: 0.55; }
  to   { transform: scale(1.025); opacity: 1; }
}

.rename-field input {
  height: 64rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--brand);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.rename-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  padding-top: 8rpx;
  color: var(--sub);
  font-size: 23rpx;
}

.rename-save {
  color: var(--brand);
}

.create-section {
  padding: 54rpx 8rpx 38rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.create-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.create-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 29rpx;
}

.placeholder {
  color: var(--faint);
}

.create-button {
  width: 128rpx;
  height: 84rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: var(--brand);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}

.notice {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: var(--bg-soft);
  color: var(--sub);
  font-size: 22rpx;
  line-height: 1.4;
}

.notice-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--sub);
  border-radius: 50%;
  text-align: center;
  line-height: 27rpx;
  font-size: 20rpx;
}

.order-hint {
  margin-top: 28rpx;
  text-align: center;
  color: var(--sub);
  font-size: 22rpx;
}

.bottom-space {
  height: 190rpx;
}

.target-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
}

.target-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 21, 31, 0.38);
}

.target-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  animation: sheet-up var(--dur-2) var(--ease) both;
  padding: 0 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.target-head {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 650;
}

.target-close {
  color: var(--sub);
  font-size: 24rpx;
  font-weight: 400;
}

.target-list {
  max-height: 58vh;
}

.target-option {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 27rpx;
}
.target-body {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 16rpx;
}
.target-name {
  font-size: 27rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.target-count {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--faint);
}

.move-arrow {
  color: var(--faint);
}
