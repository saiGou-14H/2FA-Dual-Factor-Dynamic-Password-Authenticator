.dt-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 250;
  display: flex;
  align-items: flex-end;
}

.dt-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 21, 31, 0.42);
  animation: fade 0.18s ease both;
}

.dt-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  background: var(--bg);
  border-radius: 28rpx 28rpx 0 0;
  animation: sheet-up var(--dur-2) var(--ease) both;
  overflow: hidden;
}

.dt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.dt-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.dt-close {
  font-size: 27rpx;
  color: var(--sub);
}

/* 三列 */
.dt-body {
  display: flex;
  height: 420rpx;
  padding: 12rpx 20rpx;
  box-sizing: border-box;
}

.dt-col {
  flex: 1;
  height: 100%;
  min-width: 0;
}

.dt-item {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--sub);
  border-radius: 14rpx;
  transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
}

.dt-item.is-on {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 700;
}

.dt-foot {
  padding: 12rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));
}

.dt-confirm {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
}

.dt-confirm:active {
  opacity: 0.88;
  transform: scale(0.985);
}

.dt-safe {
  height: 8rpx;
}
