.auth-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 260;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 21, 31, 0.46);
  animation: fade 0.18s ease both;
}

.auth-card {
  position: relative;
  z-index: 1;
  width: calc(100% - 96rpx);
  max-width: 620rpx;
  padding: 44rpx 40rpx 36rpx;
  border-radius: 28rpx;
  background: var(--bg);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: dialog-in var(--dur-2) var(--ease) both;
}

.auth-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.auth-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: center;
}

/* 头像选择 */
.auth-avatar-btn {
  margin: 30rpx 0 0;
  padding: 0;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1;
}
.auth-avatar-btn::after {
  border: none;
}
.auth-avatar-hover {
  opacity: 0.86;
}

.auth-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--bg-soft);
}

.auth-avatar-empty {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  color: var(--faint);
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-avatar-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--brand);
}

/* 昵称输入 */
.auth-input {
  margin-top: 28rpx;
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--bg-soft);
  font-size: 29rpx;
  color: var(--ink);
  text-align: center;
  box-sizing: border-box;
}

.auth-placeholder {
  color: var(--faint);
  font-size: 26rpx;
}

/* 操作 */
.auth-actions {
  margin-top: 30rpx;
  width: 100%;
  display: flex;
}

.auth-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 29rpx;
  font-weight: 600;
  transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
}

.auth-btn:active {
  opacity: 0.86;
  transform: scale(0.985);
}

.auth-btn-ghost {
  margin-right: 20rpx;
  background: var(--bg-soft);
  color: var(--sub);
}

.auth-btn-solid {
  background: var(--brand);
  color: #fff;
}

.auth-hint {
  margin-top: 22rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: center;
}
