<view class="auth-overlay" wx:if="{{show}}">
  <view class="auth-mask" bindtap="onSkip"></view>
  <view class="auth-card">
    <view class="auth-title">完善你的身份</view>
    <view class="auth-sub">头像与昵称用于在设置里标识当前身份，仅存本机与你的加密保险库，不会明文上传。</view>

    <!-- ============ 头像：两条静态分支，按环境自动选 ============ -->
    <!-- 支持 chooseAvatar 的环境：用微信头像 -->
    <block wx:if="{{canUseAvatar}}">
      <button
        class="auth-avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        bindtap="onAvatarBtnTap"
        hover-class="auth-avatar-hover"
      >
        <image class="auth-avatar" wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" />
        <view class="auth-avatar-empty" wx:else>
          <view class="ico ico-plus"></view>
        </view>
        <text class="auth-avatar-tip">{{avatar ? '点击更换头像' : '使用微信头像'}}</text>
      </button>
      <view class="auth-album" bindtap="pickFromAlbum">或从相册选择图片</view>
    </block>

    <!-- 不支持的环境：直接走系统相册，任何版本都可用 -->
    <block wx:else>
      <button
        class="auth-avatar-btn"
        bindtap="pickFromAlbum"
        hover-class="auth-avatar-hover"
      >
        <image class="auth-avatar" wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" />
        <view class="auth-avatar-empty" wx:else>
          <view class="ico ico-plus"></view>
        </view>
        <text class="auth-avatar-tip">{{avatar ? '点击更换头像' : '选择头像图片'}}</text>
      </button>
    </block>

    <!-- ============ 昵称：两条静态分支 ============ -->
    <!-- 支持 nickname 键盘候选：可用微信昵称一键填入 -->
    <input
      wx:if="{{canUseNickname}}"
      class="auth-input"
      type="nickname"
      value="{{nickname}}"
      placeholder="点击使用微信昵称"
      placeholder-class="auth-placeholder"
      maxlength="20"
      bindinput="onNickname"
      bindblur="onNickname"
    />
    <!-- 不支持：普通文本输入，直接手打 -->
    <input
      wx:else
      class="auth-input"
      type="text"
      value="{{nickname}}"
      placeholder="输入一个昵称"
      placeholder-class="auth-placeholder"
      maxlength="20"
      bindinput="onNickname"
      bindblur="onNickname"
    />

    <view class="auth-nick-hint">{{canUseNickname ? '也可以直接手动输入昵称' : '当前环境不支持微信昵称，请手动输入'}}</view>

    <view class="auth-actions">
      <view class="auth-btn auth-btn-ghost" bindtap="onSkip">以后再说</view>
      <view class="auth-btn auth-btn-solid" bindtap="onConfirm">完成</view>
    </view>

    <view class="auth-hint">微信已不再开放自动读取昵称的接口，需要你主动选择或输入一次。</view>
  </view>
</view>
