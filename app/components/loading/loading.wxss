.loading-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(16, 20, 24, 0.28);
  animation: fade 0.16s ease both;
}

.loading-box {
  min-width: 220rpx;
  padding: 36rpx 40rpx 30rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 20rpx 50rpx -16rpx rgba(17, 24, 39, 0.42);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: dialog-in 0.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

/* 旋转环 */
.loading-ring {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 5rpx solid var(--line-strong);
  border-top-color: var(--brand);
  animation: spin 0.72s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--sub);
  letter-spacing: 0.5rpx;
}
